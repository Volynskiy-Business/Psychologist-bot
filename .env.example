# Telegram
BOT_TOKEN=
BOT_DISPLAY_NAME=PsySupport AI

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional: separate free model for safety classifier (separate quota pool from OPENROUTER_MODEL)
# Leave empty to use the same model as OPENROUTER_MODEL.
CLASSIFIER_MODEL=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/psybot
REDIS_URL=redis://redis:6379/0

# Admin
ADMIN_TELEGRAM_IDS=

# Privacy
STORE_CONVERSATIONS=false
MESSAGE_RETENTION_DAYS=30
SAFETY_EVENT_RETENTION_DAYS=180

# App
APP_ENV=development
LOG_LEVEL=INFO

# Langfuse LLM observability (optional — leave empty to disable)
# Cloud: https://cloud.langfuse.com  |  Self-hosted: your own host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to true only if you consent to storing user message content in Langfuse
LANGFUSE_LOG_CONTENT=false
